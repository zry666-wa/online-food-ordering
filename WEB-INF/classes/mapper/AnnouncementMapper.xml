<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.food.dao.AnnouncementMapper">

    <resultMap id="annMap" type="Announcement">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="findAll" resultMap="annMap">
        SELECT * FROM t_announcement ORDER BY id DESC
    </select>

    <select id="findById" resultMap="annMap">
        SELECT * FROM t_announcement WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="Announcement" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_announcement (title, content) VALUES (#{title}, #{content})
    </insert>

    <update id="update" parameterType="Announcement">
        UPDATE t_announcement SET title = #{title}, content = #{content} WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM t_announcement WHERE id = #{id}
    </delete>
</mapper>
